# To run in development mode with mock data, set the following variable:
VITE_USE_FAKE_DATA=true

# To run with real data, comment out or remove the VITE_USE_FAKE_DATA variable
# and provide your Google Client ID below. Server-only API keys must never use a VITE_ prefix.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
SERPAPI_KEY="YOUR_SERPAPI_KEY"
SPOONACULAR_API_KEY="YOUR_SPOONACULAR_API_KEY"
